# ── Виртуальное окружение и интерпретатор ────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class

# ── Сборка и упаковка ─────────────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
wheels/

# ── Кеши инструментов ─────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.benchmarks/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# ── Компиляция на лету (torch/numba) ──────────────────────────────────────
torchinductor_*/
triton_cache/

# ── Временные каталоги агентов и прогонов ─────────────────────────────────
# ВНИМАНИЕ: в некоторых окружениях tempfile.gettempdir() возвращает корень
# репозитория, поэтому mkdtemp() без dir= создаёт папки прямо здесь.
# Список префиксов дублируется в .agent-protocol.json -> boundaries.
.scratch/
.zwork/
tmp*/
*_e2e_*/
*_harness_*/

# ── Локальные базы и runtime-состояние ────────────────────────────────────
# Runtime-БД НИКОГДА не должна быть тестовым кэшем: тесты пишут в tmp_path.
*.db
*.db-journal
*.sqlite
*.sqlite3

# ── Логи и окружение ──────────────────────────────────────────────────────
*.log
.env
.env.*
!.env.example

# ── IDE и ОС ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# ── Координационные файлы ─────────────────────────────────────────────────
# .agent-protocol.json, .agent-handoff.json и docs/agent-status.json
# КОММИТЯТСЯ намеренно: координация команды не должна жить в чужой ветке.
#
# Исключаются только производные:
#   .agent-events.jsonl — сырой поток событий дашборда, большой и не нужен
#                         для чтения состояния;
#   .agent-handoff.backups/ — бэкапы repair-encoding, восстанавливаемы.
.agent-events.jsonl
.agent-handoff.backups/

# ── pytest: каталоги tmp_path ─────────────────────────────────────────────
.pytest-of-*/
