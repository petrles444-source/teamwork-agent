[
  {
    "name": "pytest",
    "args": ["-m", "pytest", "-q"],
    "note": "все тесты"
  },
  {
    "name": "lint",
    "args": ["-m", "ruff", "check", "."],
    "note": "стиль и типовые ошибки"
  },
  {
    "name": "coordination",
    "args": ["scripts/agent_handoff.py", "validate"],
    "note": "целостность coordination-файлов"
  },
  {
    "name": "e2e",
    "args": ["-u", "scripts/e2e_check.py"],
    "note": "сквозная проверка: путь данных от начала до результата"
  },
  {
    "name": "real_data",
    "args": ["-u", "scripts/check_e2e_real_data.py", "--limit", "1000"],
    "note": "проверка на реальных данных проекта",
    "requires": "data/*.csv"
  },
  {
    "name": "perf",
    "args": ["-u", "scripts/bench_pipeline.py", "--limit", "1000"],
    "note": "производительность узкого места",
    "requires": "data/*.csv"
  }
]
